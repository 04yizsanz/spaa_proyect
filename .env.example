# =============================================================================
# ARCHIVO: .env.example
# TIPO: Plantilla de variables de entorno
# PROPÓSITO: Define las variables de entorno requeridas por la aplicación
#             Laravel. Este archivo no contiene valores sensibles reales y
#             está destinado a ser versionado en el repositorio de código
#             fuente como guía de configuración para nuevos entornos.
#             Cada desarrollador o servidor debe crear su propio archivo
#             .env a partir de esta plantilla, completando los valores
#             apropiados para su entorno de ejecución.
# NOTA IMPORTANTE: Este archivo no es ejecutable. Laravel lo lee únicamente
#             como referencia. El archivo operativo es .env, que nunca
#             debe incluirse en el control de versiones.
# =============================================================================

# ------------------------------------------------------------------------------
# CONFIGURACIÓN GENERAL DE LA APLICACIÓN
# ------------------------------------------------------------------------------

# APP_NAME: Cadena de texto que define el nombre de la aplicación.
# Laravel lo utiliza en notificaciones, correos y la interfaz de usuario.
APP_NAME=Laravel

# APP_ENV: Define el entorno de ejecución de la aplicación.
# Valores posibles: local, production, testing, staging.
# En entorno 'local' se habilitan herramientas de depuración.
APP_ENV=local

# APP_KEY: Clave de cifrado de la aplicación. Se genera mediante el comando
# `php artisan key:generate`. Debe permanecer vacía en esta plantilla
# y ser generada para cada entorno de forma individual.
# Es utilizada por Laravel para cifrar cookies y sesiones.
APP_KEY=

# APP_DEBUG: Valor booleano que activa o desactiva el modo de depuración.
# Cuando es true, los errores se muestran con detalle completo en el navegador.
# En producción debe establecerse siempre en false por razones de seguridad.
APP_DEBUG=true

# APP_URL: URL base de la aplicación. Laravel la utiliza para generar
# enlaces absolutos, redirecciones y referencias a recursos estáticos.
APP_URL=http://localhost

# ------------------------------------------------------------------------------
# LOCALIZACIÓN E INTERNACIONALIZACIÓN
# ------------------------------------------------------------------------------

# APP_LOCALE: Idioma principal de la aplicación para traducciones y
# formatos de fecha y número.
APP_LOCALE=en

# APP_FALLBACK_LOCALE: Idioma alternativo que se utiliza cuando una
# traducción no está disponible en el idioma principal.
APP_FALLBACK_LOCALE=en

# APP_FAKER_LOCALE: Localización utilizada por la biblioteca Faker al
# generar datos ficticios para seeders y pruebas automatizadas.
APP_FAKER_LOCALE=en_US

# ------------------------------------------------------------------------------
# MODO MANTENIMIENTO
# ------------------------------------------------------------------------------

# APP_MAINTENANCE_DRIVER: Define el controlador que gestiona el modo de
# mantenimiento. El valor 'file' almacena el estado en el sistema de archivos.
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# ------------------------------------------------------------------------------
# SEGURIDAD Y CIFRADO
# ------------------------------------------------------------------------------

# BCRYPT_ROUNDS: Número de rondas de procesamiento del algoritmo bcrypt
# al hashear contraseñas. A mayor valor, mayor seguridad y mayor tiempo
# de procesamiento. El valor 12 es el estándar recomendado.
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# SISTEMA DE REGISTRO DE EVENTOS (LOGGING)
# ------------------------------------------------------------------------------

# LOG_CHANNEL: Canal de registro utilizado por defecto. El valor 'stack'
# permite encadenar múltiples canales simultáneamente.
LOG_CHANNEL=stack

# LOG_STACK: Define los canales incluidos en el stack de registro.
# El valor 'single' dirige todos los mensajes a un único archivo de log.
LOG_STACK=single

# LOG_DEPRECATIONS_CHANNEL: Canal donde se registran las advertencias
# sobre el uso de características deprecadas. 'null' las descarta.
LOG_DEPRECATIONS_CHANNEL=null

# LOG_LEVEL: Nivel mínimo de severidad que se registra. En modo 'debug'
# se registran todos los niveles: debug, info, notice, warning, error,
# critical, alert y emergency.
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# CONEXIÓN A BASE DE DATOS
# ------------------------------------------------------------------------------

# DB_CONNECTION: Motor de base de datos a utilizar. Debe coincidir con
# una de las claves definidas en config/database.php.
# Valores soportados: mysql, sqlite, pgsql, sqlsrv, mariadb.
DB_CONNECTION=mysql

# DB_HOST: Dirección del servidor de base de datos. El valor 'db' hace
# referencia al nombre del servicio en un entorno Docker Compose.
DB_HOST=db

# DB_PORT: Puerto de conexión al servidor de base de datos.
# El puerto estándar de MySQL y MariaDB es 3306.
DB_PORT=3306

# DB_DATABASE: Nombre del esquema o base de datos a utilizar dentro
# del servidor configurado.
DB_DATABASE=spaa_proyect

# DB_USERNAME: Nombre de usuario con permisos sobre la base de datos.
DB_USERNAME=root

# DB_PASSWORD: Contraseña del usuario de base de datos. Se deja vacía
# en esta plantilla. Debe completarse con el valor real en el archivo .env.
DB_PASSWORD=

# ------------------------------------------------------------------------------
# GESTIÓN DE SESIONES
# ------------------------------------------------------------------------------

# SESSION_DRIVER: Mecanismo de almacenamiento de sesiones de usuario.
# El valor 'file' guarda las sesiones como archivos en
# storage/framework/sessions. Otros valores posibles: database, redis, cookie.
SESSION_DRIVER=file

# SESSION_LIFETIME: Tiempo de vida de la sesión en minutos antes de que
# sea considerada inválida por inactividad.
SESSION_LIFETIME=120

# SESSION_ENCRYPT: Define si el contenido de la sesión se cifra antes
# de almacenarse. El valor false desactiva el cifrado adicional.
SESSION_ENCRYPT=false

# SESSION_PATH: Ruta de la cookie de sesión en el navegador del cliente.
# El carácter '/' indica que la cookie es válida para toda la aplicación.
SESSION_PATH=/

# SESSION_DOMAIN: Dominio asociado a la cookie de sesión.
# El valor null utiliza el dominio actual de la aplicación.
SESSION_DOMAIN=null

# ------------------------------------------------------------------------------
# SERVICIOS DE MENSAJERÍA Y COLAS
# ------------------------------------------------------------------------------

# BROADCAST_CONNECTION: Controlador para la difusión de eventos en tiempo real.
# El valor 'log' registra los eventos en el sistema de logging sin emitirlos.
BROADCAST_CONNECTION=log

# FILESYSTEM_DISK: Disco de almacenamiento de archivos predeterminado,
# según la configuración definida en config/filesystems.php.
FILESYSTEM_DISK=local

# QUEUE_CONNECTION: Controlador para la gestión de colas de trabajo.
# El valor 'sync' ejecuta los trabajos de forma sincrónica e inmediata,
# sin encolarlos para procesamiento posterior.
QUEUE_CONNECTION=sync

# ------------------------------------------------------------------------------
# CACHÉ
# ------------------------------------------------------------------------------

# CACHE_STORE: Motor de caché utilizado por la aplicación.
# El valor 'file' almacena el caché en el sistema de archivos local.
CACHE_STORE=file
# CACHE_PREFIX=

# ------------------------------------------------------------------------------
# MEMCACHED
# ------------------------------------------------------------------------------

# MEMCACHED_HOST: Dirección del servidor Memcached, utilizado como motor
# de caché distribuida de alto rendimiento.
MEMCACHED_HOST=127.0.0.1

# ------------------------------------------------------------------------------
# REDIS
# ------------------------------------------------------------------------------

# REDIS_CLIENT: Biblioteca PHP utilizada para conectarse a Redis.
# El valor 'phpredis' utiliza la extensión nativa de PHP.
REDIS_CLIENT=phpredis

# REDIS_HOST: Dirección del servidor Redis.
REDIS_HOST=127.0.0.1

# REDIS_PASSWORD: Contraseña de autenticación de Redis. El valor null
# indica que no se requiere autenticación.
REDIS_PASSWORD=null

# REDIS_PORT: Puerto de escucha del servidor Redis. El valor estándar es 6379.
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# CORREO ELECTRÓNICO
# ------------------------------------------------------------------------------

# MAIL_MAILER: Controlador de envío de correo. El valor 'log' registra
# los correos en el sistema de logging sin enviarlos realmente,
# lo que es útil durante el desarrollo.
MAIL_MAILER=log

# MAIL_SCHEME: Protocolo de seguridad del servidor de correo (ej: ssl, tls).
# El valor null utiliza la configuración predeterminada del servidor.
MAIL_SCHEME=null

# MAIL_HOST: Dirección del servidor SMTP para el envío de correos.
MAIL_HOST=127.0.0.1

# MAIL_PORT: Puerto del servidor SMTP. El puerto 2525 es utilizado
# frecuentemente en entornos de desarrollo con herramientas como Mailhog.
MAIL_PORT=2525

# MAIL_USERNAME y MAIL_PASSWORD: Credenciales de autenticación SMTP.
# Se dejan vacías en entornos de desarrollo sin servidor real configurado.
MAIL_USERNAME=null
MAIL_PASSWORD=null

# MAIL_FROM_ADDRESS: Dirección de correo electrónico que aparece como
# remitente en los correos enviados por la aplicación.
MAIL_FROM_ADDRESS="hello@example.com"

# MAIL_FROM_NAME: Nombre del remitente que se muestra al destinatario.
# La sintaxis "${APP_NAME}" hace referencia al valor definido en APP_NAME.
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# AMAZON WEB SERVICES (AWS S3)
# ------------------------------------------------------------------------------

# Las siguientes variables configuran el acceso al servicio de almacenamiento
# Amazon S3. Se dejan vacías ya que este proyecto no utiliza S3 por defecto.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ------------------------------------------------------------------------------
# VITE (COMPILADOR DE RECURSOS FRONTEND)
# ------------------------------------------------------------------------------

# VITE_APP_NAME: Variable expuesta al código JavaScript durante la
# compilación de recursos con Vite. Permite que el frontend acceda al
# nombre de la aplicación. La sintaxis "${APP_NAME}" hereda el valor
# definido en la variable APP_NAME de este mismo archivo.
VITE_APP_NAME="${APP_NAME}"
